# Local use: http://localhost:3000. Production: your real https:// domain.
APP_URL=http://localhost:3000

# Supabase project settings (https://supabase.com/dashboard/project/_/settings/database).
# Use the pooled connection string, Transaction mode, port 6543.
DATABASE_URL=postgresql://postgres.xxxxxxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase project URL and service_role key (Settings -> API). Server-only, never expose
# these to the browser. Used to read/write the private "uploads" storage bucket.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
